!.claude/skills/*/cookies/.gitkeep

# python-кэш в скиллах
.claude/skills/**/__pycache__/

# снятые VK-статьи (артефакты baslie-vk-article-extractor)
/vk-articles/

# артефакты браузерных скриншотов в корне
/desktop-*.png
/mobile-*.png
