---
import VkIcon from "@/components/icons/VkIcon.astro";
import TelegramIcon from "@/components/icons/TelegramIcon.astro";

interface Props {
  transparentOnTop?: boolean;
}

const { transparentOnTop = false } = Astro.props;

const navLinks = [
  { href: "/", label: "Маршруты" },
  { href: "/articles", label: "Статьи" },
  { href: "/about", label: "О проекте" },
  { href: "/contacts", label: "Контакты" },
] as const;

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/" || currentPath.startsWith("/trails");
  return currentPath.startsWith(href);
}
---

<header
  class="site-header fixed top-0 left-0 right-0 z-50 w-full transition-colors duration-200"
  data-transparent-on-top={transparentOnTop ? "true" : "false"}
  data-scrolled={transparentOnTop ? "false" : "true"}
>
  <div class="container flex h-16 items-center justify-between">
    <a
      href="/"
      class="flex items-center transition-opacity hover:opacity-80"
      aria-label="Томская Прогулка"
    >
      <img
        src="/logo-white.svg"
        alt=""
        aria-hidden="true"
        class="logo logo-light h-8 w-auto"
      />
      <img
        src="/logo.svg"
        alt="Томская Прогулка"
        class="logo logo-dark h-8 w-auto"
      />
    </a>

    <nav class="hidden items-center gap-6 md:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            data-active={isActive(link.href) ? "true" : "false"}
            class="nav-link text-sm font-medium transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <label
      for="mobile-drawer-toggle"
      class="mobile-burger flex size-9 cursor-pointer items-center justify-center rounded-md transition-colors md:hidden"
      aria-label="Меню"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="3" x2="21" y1="6" y2="6"></line>
        <line x1="3" x2="21" y1="12" y2="12"></line>
        <line x1="3" x2="21" y1="18" y2="18"></line>
      </svg>
    </label>
  </div>
</header>

<input id="mobile-drawer-toggle" type="checkbox" class="mobile-drawer-toggle" />
<label
  for="mobile-drawer-toggle"
  class="mobile-drawer-overlay fixed inset-0 z-40 bg-black/40 md:hidden"
  aria-hidden="true"></label>

<aside
  class="mobile-drawer fixed top-0 right-0 z-50 flex h-full w-[280px] flex-col border-l border-[var(--border)] bg-[var(--background)] md:hidden"
>
  <div class="flex h-16 items-center justify-end px-6">
    <label
      for="mobile-drawer-toggle"
      class="flex size-8 cursor-pointer items-center justify-center rounded-md hover:bg-[var(--muted)]"
      aria-label="Закрыть"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M18 6 6 18"></path>
        <path d="m6 6 12 12"></path>
      </svg>
    </label>
  </div>

  <nav class="flex flex-col gap-1 px-4">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "rounded-md px-3 py-3 text-base font-medium transition-colors",
            isActive(link.href)
              ? "bg-[var(--muted)] text-[var(--foreground)]"
              : "text-[var(--foreground)] hover:bg-[var(--muted)]",
          ]}
        >
          {link.label}
        </a>
      ))
    }
  </nav>

  <div class="mt-auto border-t border-[var(--border)] px-6 py-5">
    <p
      class="mb-3 text-xs font-medium uppercase tracking-wider text-[var(--muted-foreground)]"
    >
      Связаться
    </p>
    <div class="flex flex-col gap-3">
      <a
        href="https://vk.com/tomsk_progulka"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm text-[var(--foreground)] transition-opacity hover:opacity-70"
      >
        <VkIcon class="h-4 w-4" />
        ВКонтакте
      </a>
      <a
        href="https://t.me/tomsk_progulka"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm text-[var(--foreground)] transition-opacity hover:opacity-70"
      >
        <TelegramIcon class="h-4 w-4" />
        Telegram
      </a>
    </div>
    <p class="mt-5 text-xs text-[var(--muted-foreground)]">
      © 2016–2026 Томская Прогулка
    </p>
  </div>
</aside>

<style>
  /* Scrolled (default opaque) state */
  .site-header[data-scrolled="true"] {
    background-color: color-mix(in oklab, var(--background) 95%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  @supports (backdrop-filter: blur(8px)) {
    .site-header[data-scrolled="true"] {
      background-color: color-mix(in oklab, var(--background) 80%, transparent);
    }
  }

  /* Logo swap */
  .logo-light {
    display: none;
  }
  .site-header[data-scrolled="false"] .logo-light {
    display: block;
  }
  .site-header[data-scrolled="false"] .logo-dark {
    display: none;
  }

  /* Nav links */
  .nav-link {
    color: var(--muted-foreground);
  }
  .nav-link[data-active="true"] {
    color: var(--foreground);
  }
  .nav-link:hover {
    color: var(--foreground);
  }

  .site-header[data-scrolled="false"] .nav-link {
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
  }
  .site-header[data-scrolled="false"] .nav-link[data-active="true"],
  .site-header[data-scrolled="false"] .nav-link:hover {
    color: #ffffff;
  }

  /* Mobile burger */
  .mobile-burger {
    color: var(--foreground);
  }
  .mobile-burger:hover {
    background-color: var(--muted);
  }
  .site-header[data-scrolled="false"] .mobile-burger {
    color: #ffffff;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.35));
  }
  .site-header[data-scrolled="false"] .mobile-burger:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  if (header && header.dataset.transparentOnTop === "true") {
    let ticking = false;
    const SCROLL_THRESHOLD = 8;

    const update = () => {
      const scrolled = window.scrollY > SCROLL_THRESHOLD;
      header.dataset.scrolled = scrolled ? "true" : "false";
      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(update);
        ticking = true;
      }
    };

    update();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
