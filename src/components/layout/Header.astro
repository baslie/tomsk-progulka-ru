---
interface Props {
  transparentOnTop?: boolean;
}

const { transparentOnTop = false } = Astro.props;

const navLinks = [
  { href: "/trails", label: "Маршруты" },
  { href: "/articles", label: "Статьи" },
  { href: "/about", label: "О проекте" },
  { href: "/contacts", label: "Контакты" },
] as const;

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  return currentPath.startsWith(href);
}
---

<header
  class="site-header fixed top-0 left-0 right-0 z-50 w-full transition-colors duration-200"
  data-transparent-on-top={transparentOnTop ? "true" : "false"}
  data-scrolled={transparentOnTop ? "false" : "true"}
>
  <div class="container flex h-16 items-center justify-between">
    <a href="/" class="flex items-center transition-opacity hover:opacity-80" aria-label="Томская Прогулка">
      <img src="/logo-white.svg" alt="" aria-hidden="true" class="logo logo-light h-8 w-auto" />
      <img src="/logo.svg" alt="Томская Прогулка" class="logo logo-dark h-8 w-auto" />
    </a>

    <nav class="hidden items-center gap-6 md:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            data-active={isActive(link.href) ? "true" : "false"}
            class="nav-link text-sm font-medium transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <label
      for="mobile-drawer-toggle"
      class="mobile-burger flex size-9 cursor-pointer items-center justify-center rounded-md transition-colors md:hidden"
      aria-label="Меню"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" x2="21" y1="6" y2="6" />
        <line x1="3" x2="21" y1="12" y2="12" />
        <line x1="3" x2="21" y1="18" y2="18" />
      </svg>
    </label>
  </div>
</header>

<input id="mobile-drawer-toggle" type="checkbox" class="mobile-drawer-toggle" />
<label for="mobile-drawer-toggle" class="mobile-drawer-overlay fixed inset-0 z-40 bg-black/40 md:hidden" aria-hidden="true"></label>

<aside class="mobile-drawer fixed top-0 right-0 z-50 flex h-full w-[280px] flex-col border-l border-[var(--border)] bg-[var(--background)] md:hidden">
  <div class="flex h-16 items-center justify-end px-6">
    <label
      for="mobile-drawer-toggle"
      class="flex size-8 cursor-pointer items-center justify-center rounded-md hover:bg-[var(--muted)]"
      aria-label="Закрыть"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 6 6 18" />
        <path d="m6 6 12 12" />
      </svg>
    </label>
  </div>

  <nav class="flex flex-col gap-1 px-4">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "rounded-md px-3 py-3 text-base font-medium transition-colors",
            isActive(link.href)
              ? "bg-[var(--muted)] text-[var(--foreground)]"
              : "text-[var(--foreground)] hover:bg-[var(--muted)]",
          ]}
        >
          {link.label}
        </a>
      ))
    }
  </nav>

  <div class="mt-auto border-t border-[var(--border)] px-6 py-5">
    <p class="mb-3 text-xs font-medium uppercase tracking-wider text-[var(--muted-foreground)]">
      Связаться
    </p>
    <div class="flex flex-col gap-3">
      <a
        href="https://vk.com/tomsk_progulka"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm text-[var(--foreground)] transition-opacity hover:opacity-70"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12.785 16.241s.288-.032.436-.194c.136-.148.132-.427.132-.427s-.02-1.304.587-1.496c.596-.19 1.364 1.259 2.178 1.816.616.42 1.084.328 1.084.328l2.18-.03s1.14-.071.6-.972c-.046-.074-.322-.667-1.654-1.886-1.394-1.278-1.207-1.07.472-3.28.976-1.348 1.367-2.17 1.246-2.52-.115-.335-.823-.247-.823-.247l-2.455.015s-.182-.025-.317.056c-.132.08-.216.266-.216.266s-.388 1.035-.906 1.912c-1.092 1.848-1.53 1.946-1.708 1.832-.416-.265-.312-1.066-.312-1.635 0-1.778.269-2.52-.525-2.713-.263-.064-.457-.106-1.132-.113-.866-.009-1.598.003-2.013.207-.276.135-.49.438-.359.455.161.022.525.099.718.363.25.34.24 1.108.24 1.108s.143 2.093-.334 2.352c-.327.18-.777-.186-1.741-1.854-.494-.854-.867-1.798-.867-1.798s-.072-.177-.2-.272c-.156-.115-.373-.152-.373-.152l-2.333.015s-.35.01-.478.163c-.114.135-.009.416-.009.416s1.825 4.273 3.893 6.426c1.896 1.975 4.048 1.845 4.048 1.845l.971-.003z" />
        </svg>
        ВКонтакте
      </a>
      <a
        href="https://t.me/tomsk_progulka"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm text-[var(--foreground)] transition-opacity hover:opacity-70"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z" />
        </svg>
        Telegram
      </a>
    </div>
    <p class="mt-5 text-xs text-[var(--muted-foreground)]">
      © 2016–2026 Томская Прогулка
    </p>
  </div>
</aside>

<style>
  /* Scrolled (default opaque) state */
  .site-header[data-scrolled="true"] {
    background-color: color-mix(in oklab, var(--background) 95%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  @supports (backdrop-filter: blur(8px)) {
    .site-header[data-scrolled="true"] {
      background-color: color-mix(in oklab, var(--background) 80%, transparent);
    }
  }

  /* Logo swap */
  .logo-light { display: none; }
  .site-header[data-scrolled="false"] .logo-light { display: block; }
  .site-header[data-scrolled="false"] .logo-dark { display: none; }

  /* Nav links */
  .nav-link {
    color: var(--muted-foreground);
  }
  .nav-link[data-active="true"] {
    color: var(--foreground);
  }
  .nav-link:hover {
    color: var(--foreground);
  }

  .site-header[data-scrolled="false"] .nav-link {
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
  }
  .site-header[data-scrolled="false"] .nav-link[data-active="true"],
  .site-header[data-scrolled="false"] .nav-link:hover {
    color: #ffffff;
  }

  /* Mobile burger */
  .mobile-burger {
    color: var(--foreground);
  }
  .mobile-burger:hover {
    background-color: var(--muted);
  }
  .site-header[data-scrolled="false"] .mobile-burger {
    color: #ffffff;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.35));
  }
  .site-header[data-scrolled="false"] .mobile-burger:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  if (header && header.dataset.transparentOnTop === "true") {
    let ticking = false;
    const SCROLL_THRESHOLD = 8;

    const update = () => {
      const scrolled = window.scrollY > SCROLL_THRESHOLD;
      header.dataset.scrolled = scrolled ? "true" : "false";
      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(update);
        ticking = true;
      }
    };

    update();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
