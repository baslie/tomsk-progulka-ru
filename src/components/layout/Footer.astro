---
import VkIcon from "@/components/icons/VkIcon.astro";
import TelegramIcon from "@/components/icons/TelegramIcon.astro";

const currentYear = new Date().getFullYear();

const links = [
  { href: "/contacts", label: "Контакты", external: false, icon: null },
  {
    href: "https://vk.com/tomsk_progulka",
    label: "ВКонтакте",
    external: true,
    icon: "vk",
  },
  {
    href: "https://t.me/tomsk_progulka",
    label: "Telegram",
    external: true,
    icon: "telegram",
  },
] as const;
---

<footer class="border-t border-[var(--border)] bg-[var(--muted)]/40">
  <div
    class="container flex flex-col items-center justify-between gap-4 py-6 md:flex-row"
  >
    <p class="text-sm text-[var(--muted-foreground)]">
      &copy; 2016–{currentYear} Томская Прогулка
    </p>

    <nav class="flex items-center gap-4 md:gap-6">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="inline-flex items-center gap-1.5 text-sm text-[var(--muted-foreground)] transition-colors hover:text-[var(--foreground)]"
            {...(link.external
              ? { target: "_blank", rel: "nofollow noopener noreferrer" }
              : {})}
          >
            {link.icon === "vk" && <VkIcon class="h-4 w-4" />}
            {link.icon === "telegram" && <TelegramIcon class="h-4 w-4" />}
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
