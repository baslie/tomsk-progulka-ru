---
import "@fontsource-variable/inter";
import "@/styles/globals.css";
import YandexMetrika from "@/components/analytics/YandexMetrika.astro";
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="p:domain_verify" content="b791ec9276857eddc8fa55257606340b" />
    <title>Томская Прогулка</title>
    <meta name="description" content="Походы и прогулки по Томску и Томской области с 2016 года" />
    <meta property="og:title" content="Томская Прогулка" />
    <meta property="og:description" content="Походы и прогулки по Томску и Томской области с 2016 года" />
    <meta property="og:type" content="website" />
    <YandexMetrika />
  </head>
  <body class="min-h-screen flex items-center justify-center bg-white">
    <div class="flex flex-col items-center gap-8 px-6 max-w-xl text-center">
      <img
        src="/logo.svg"
        alt="Томская Прогулка"
        class="w-72 sm:w-88 md:w-96 h-auto"
      />

      <p class="text-[#0A0A0A]/70 text-base sm:text-lg leading-relaxed">
        Ходим в небольшие однодневные походы-прогулки в окрестностях Томска, Северска (и не только) по выходным. Присоединяйтесь 🙌🏻
      </p>

      <div class="flex items-center gap-4">
        <a
          href="https://vk.com/tomsk_progulka"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 px-5 py-3 rounded-2xl text-white text-sm font-semibold transition-all duration-150 select-none"
          style="background: #0077FF; box-shadow: 0 4px 0 #0057CC, 0 6px 12px rgba(0,119,255,0.35); transform: translateY(0);"
          onmousedown="this.style.transform='translateY(3px)';this.style.boxShadow='0 1px 0 #0057CC, 0 2px 6px rgba(0,119,255,0.25)'"
          onmouseup="this.style.transform='translateY(0)';this.style.boxShadow='0 4px 0 #0057CC, 0 6px 12px rgba(0,119,255,0.35)'"
          onmouseleave="this.style.transform='translateY(0)';this.style.boxShadow='0 4px 0 #0057CC, 0 6px 12px rgba(0,119,255,0.35)'"
        >
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.785 16.241s.288-.032.436-.194c.136-.148.132-.427.132-.427s-.02-1.304.587-1.496c.596-.19 1.364 1.259 2.178 1.816.616.42 1.084.328 1.084.328l2.18-.03s1.14-.071.6-.972c-.046-.074-.322-.667-1.654-1.886-1.394-1.278-1.207-1.07.472-3.28.976-1.348 1.367-2.17 1.246-2.52-.115-.335-.823-.247-.823-.247l-2.455.015s-.182-.025-.317.056c-.132.08-.216.266-.216.266s-.388 1.035-.906 1.912c-1.092 1.848-1.53 1.946-1.708 1.832-.416-.265-.312-1.066-.312-1.635 0-1.778.269-2.52-.525-2.713-.263-.064-.457-.106-1.132-.113-.866-.009-1.598.003-2.013.207-.276.135-.49.438-.359.455.161.022.525.099.718.363.25.34.24 1.108.24 1.108s.143 2.093-.334 2.352c-.327.18-.777-.186-1.741-1.854-.494-.854-.867-1.798-.867-1.798s-.072-.177-.2-.272c-.156-.115-.373-.152-.373-.152l-2.333.015s-.35.01-.478.163c-.114.135-.009.416-.009.416s1.825 4.273 3.893 6.426c1.896 1.975 4.048 1.845 4.048 1.845l.971-.003z" />
          </svg>
          ВКонтакте
        </a>

        <a
          href="https://t.me/tomsk_progulka"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 px-5 py-3 rounded-2xl text-white text-sm font-semibold transition-all duration-150 select-none"
          style="background: #2AABEE; box-shadow: 0 4px 0 #1A8BC4, 0 6px 12px rgba(42,171,238,0.35); transform: translateY(0);"
          onmousedown="this.style.transform='translateY(3px)';this.style.boxShadow='0 1px 0 #1A8BC4, 0 2px 6px rgba(42,171,238,0.25)'"
          onmouseup="this.style.transform='translateY(0)';this.style.boxShadow='0 4px 0 #1A8BC4, 0 6px 12px rgba(42,171,238,0.35)'"
          onmouseleave="this.style.transform='translateY(0)';this.style.boxShadow='0 4px 0 #1A8BC4, 0 6px 12px rgba(42,171,238,0.35)'"
        >
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z" />
          </svg>
          Телеграм
        </a>
      </div>
    </div>
  </body>
</html>
