---
import "@fontsource-variable/inter";
import "@/styles/globals.css";
import YandexMetrika from "@/components/analytics/YandexMetrika.astro";
import VkIcon from "@/components/icons/VkIcon.astro";
import TelegramIcon from "@/components/icons/TelegramIcon.astro";
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="p:domain_verify" content="b791ec9276857eddc8fa55257606340b" />
    <title>Томская Прогулка</title>
    <meta name="description" content="Походы и прогулки по Томску и Томской области с 2016 года" />
    <meta property="og:title" content="Томская Прогулка" />
    <meta property="og:description" content="Походы и прогулки по Томску и Томской области с 2016 года" />
    <meta property="og:type" content="website" />
    <YandexMetrika />
  </head>
  <body class="min-h-screen flex items-center justify-center bg-white">
    <div class="flex flex-col items-center gap-8 px-6 max-w-xl text-center">
      <img
        src="/logo.svg"
        alt="Томская Прогулка"
        class="w-72 sm:w-88 md:w-96 h-auto"
      />

      <p class="text-[#0A0A0A]/70 text-base sm:text-lg leading-relaxed">
        Ходим в небольшие однодневные походы-прогулки в окрестностях Томска, Северска (и не только) по выходным. Присоединяйтесь 🙌🏻
      </p>

      <div class="flex items-center gap-4">
        <a
          href="https://vk.com/tomsk_progulka"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-3d inline-flex items-center gap-2.5 px-5 py-3 rounded-2xl text-white text-sm font-semibold transition-all duration-150 select-none"
          style="--btn-bg:#0077FF;--btn-shadow:0 4px 0 #0057CC, 0 6px 12px rgba(0,119,255,0.35);--btn-shadow-active:0 1px 0 #0057CC, 0 2px 6px rgba(0,119,255,0.25)"
        >
          <VkIcon class="h-5 w-5 shrink-0" />
          ВКонтакте
        </a>

        <a
          href="https://t.me/tomsk_progulka"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-3d inline-flex items-center gap-2.5 px-5 py-3 rounded-2xl text-white text-sm font-semibold transition-all duration-150 select-none"
          style="--btn-bg:#2AABEE;--btn-shadow:0 4px 0 #1A8BC4, 0 6px 12px rgba(42,171,238,0.35);--btn-shadow-active:0 1px 0 #1A8BC4, 0 2px 6px rgba(42,171,238,0.25)"
        >
          <TelegramIcon class="h-5 w-5 shrink-0" />
          Телеграм
        </a>
      </div>
    </div>

    <style>
      /* «3D»-кнопка: цвет фона и теней задаются переменными на самом элементе. */
      .btn-3d {
        background: var(--btn-bg);
        box-shadow: var(--btn-shadow);
        transform: translateY(0);
      }
      .btn-3d:active {
        transform: translateY(3px);
        box-shadow: var(--btn-shadow-active);
      }
    </style>
  </body>
</html>
