---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { RoutesCatalog } from "@/components/routes/RoutesCatalog";

const all = await getCollection("routes");
const routes = all
  .map((entry) => ({
    slug: entry.id,
    title: entry.data.title,
    description: entry.data.description,
    difficulty: entry.data.difficulty,
    season: entry.data.season,
    distanceKm: entry.data.distanceKm,
    durationMin: entry.data.durationMin,
    region: entry.data.region,
    coverImage: entry.data.coverImage,
    authorName: entry.data.author?.name,
    authorAvatar: entry.data.author?.avatar,
    isOrganizer: entry.data.author?.isOrganizer ?? false,
    gpx: entry.data.gpx,
    publishedAt: entry.data.publishedAt,
  }))
  .sort((a, b) => +new Date(b.publishedAt) - +new Date(a.publishedAt));
---

<BaseLayout
  title="Пешие маршруты по Томску и области"
  description="Каталог пешеходных маршрутов по Томску и Томской области с GPX-треками, фотографиями и подробными описаниями."
  heroOverlay={true}
>
  <section
    class="relative w-full h-[100dvh] lg:h-[68vh] min-h-[460px] overflow-hidden"
  >
    <img
      src="/images/hero/cover.jpg"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-black/30 via-black/45 to-black/70"
    >
    </div>

    <div class="relative z-10 h-full flex items-center justify-center">
      <div
        class="container max-w-3xl flex flex-col items-center text-center space-y-6"
      >
        <span
          class="inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 backdrop-blur px-3 py-1 text-xs tracking-wider text-white"
        >
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-white"></span>
          Водим походы с&nbsp;2016&nbsp;года
        </span>

        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.05] drop-shadow-md"
        >
          Пешие маршруты по&nbsp;Томску и&nbsp;области
        </h1>

        <p class="text-base md:text-lg text-white/85 max-w-xl">
          Ходим в&nbsp;небольшие однодневные походы-прогулки в&nbsp;окрестностях
          Томска, Северска (и&nbsp;не&nbsp;только) по&nbsp;выходным.
          Присоединяйтесь&nbsp;🙌🏻
        </p>

        <div
          class="flex flex-col sm:flex-row items-stretch justify-center gap-2 sm:gap-3 pt-2 w-full"
        >
          <a
            href="#catalog"
            class="w-full sm:w-auto px-3 sm:px-6 py-3 bg-white text-[var(--foreground)] rounded-md hover:bg-[var(--secondary)] transition-colors text-sm font-semibold text-center whitespace-nowrap"
          >
            Смотреть маршруты →
          </a>
          <a
            href="/about"
            class="w-full sm:w-auto px-3 sm:px-6 py-3 border border-white/60 text-white rounded-md hover:bg-white/10 transition-colors text-sm font-medium text-center whitespace-nowrap"
          >
            О&nbsp;проекте
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="catalog" class="container py-8 md:py-12 scroll-mt-16">
    <RoutesCatalog routes={routes} client:load />
  </section>
</BaseLayout>
