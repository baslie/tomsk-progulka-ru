---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ArticlesCatalog } from "@/components/articles/ArticlesCatalog";
import { ARTICLES_VISIBLE } from "@/lib/constants";

// Раздел «Статьи» временно скрыт: уводим посетителей на главную, не показывая
// список. Код и контент сохранены. См. CLAUDE.md, «Скрытый раздел „Статьи“».
if (!ARTICLES_VISIBLE) {
  return Astro.redirect("/");
}

const all = await getCollection("articles");
const articles = all
  .map((entry) => ({
    slug: entry.id,
    title: entry.data.title,
    description: entry.data.description,
    category: entry.data.category,
    coverImage: entry.data.coverImage,
    publishedAt: entry.data.publishedAt.toISOString(),
    authorName: entry.data.author?.name,
  }))
  .sort((a, b) => +new Date(b.publishedAt) - +new Date(a.publishedAt));
---

<BaseLayout
  title="Статьи"
  description="Статьи о пеших прогулках по Томской области: как добраться до маршрутов, что взять с собой, советы и правила безопасности."
>
  <section class="container py-8 md:py-12">
    <header class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight md:text-4xl">Статьи</h1>
      <p class="mt-2 max-w-2xl text-[var(--muted-foreground)]">
        Полезные материалы для подготовки к прогулкам и активному отдыху.
      </p>
    </header>

    <ArticlesCatalog articles={articles} client:load />
  </section>
</BaseLayout>
