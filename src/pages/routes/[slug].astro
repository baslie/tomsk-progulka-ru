---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Badge } from "@/components/ui/Badge";
import { RouteMap, type RouteTrack } from "@/components/maps/RouteMap";
import {
  GpxDownloadButton,
  type GpxVariant,
} from "@/components/routes/GpxDownloadButton";
import { LightboxRoot } from "@/components/media/LightboxRoot";
import {
  DIFFICULTY_LABELS,
  SEASON_LABELS,
  formatDistance,
  formatDuration,
  formatDateRu,
} from "@/lib/constants";

export async function getStaticPaths() {
  const routes = await getCollection("routes");
  return routes.map((route) => ({
    params: { slug: route.id },
    props: { route },
  }));
}

interface Props {
  route: CollectionEntry<"routes">;
}

const { route } = Astro.props;
const { Content } = await render(route);
const data = route.data;

const difficultyVariant: Record<
  keyof typeof DIFFICULTY_LABELS,
  "success" | "warning" | "danger"
> = {
  easy: "success",
  medium: "warning",
  hard: "danger",
};

const description = data.description.length > 160
  ? data.description.slice(0, 157) + "…"
  : data.description;

// Карта: показываем все варианты, если заданы; иначе — одиночный трек.
const mapTracks: RouteTrack[] = data.tracks?.length
  ? data.tracks
  : [{ name: data.title, gpx: data.gpx }];

// Скачивание GPX: ссылки на оригинальные файлы (с высотами), где они заданы.
const gpxVariants: GpxVariant[] | undefined = data.tracks?.length
  ? data.tracks.map((t, i) =>
      t.gpxFile
        ? { name: t.name, href: t.gpxFile }
        : { name: t.name, gpx: t.gpx, slug: `${route.id}-${i + 1}` }
    )
  : undefined;
---

<BaseLayout
  title={data.title}
  description={description}
  image={data.coverImage}
  type="article"
>
  <article class="container py-8 md:py-12">
    <nav class="mb-6 text-sm text-[var(--muted-foreground)]">
      <a href="/trails" class="hover:text-[var(--foreground)]">Маршруты</a>
      <span class="mx-2">/</span>
      <span>{data.title}</span>
    </nav>

    <header class="grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:gap-10">
      <div class="overflow-hidden rounded-xl bg-[var(--muted)]">
        {data.coverImageAsset ? (
          <Image
            src={data.coverImageAsset}
            alt={data.title}
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 1024px) 60vw, 100vw"
            loading="eager"
            class="h-full w-full object-cover"
          />
        ) : (
          <img
            src={data.coverImage}
            alt={data.title}
            loading="eager"
            decoding="async"
            class="h-full w-full object-cover"
          />
        )}
      </div>

      <div class="flex flex-col justify-center gap-5">
        <div class="flex flex-wrap gap-2">
          <Badge variant={difficultyVariant[data.difficulty]}>
            {DIFFICULTY_LABELS[data.difficulty]}
          </Badge>
          <Badge variant="outline">{SEASON_LABELS[data.season]}</Badge>
          <Badge variant="outline">{data.region}</Badge>
        </div>

        <h1 class="text-3xl font-bold tracking-tight md:text-4xl">{data.title}</h1>

        <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-[var(--muted-foreground)]">
          {data.author?.avatar && (
            <img
              src={data.author.avatar}
              alt={data.author.name}
              class="size-6 rounded-full object-cover"
              loading="lazy"
            />
          )}
          {data.author && (
            <span class="font-medium text-[var(--foreground)]">{data.author.name}</span>
          )}
          {data.author?.isOrganizer && <span class="text-[var(--primary)]">· Организатор</span>}
          <span>· Опубликовано {formatDateRu(data.publishedAt)}</span>
        </div>

        <dl class="grid grid-cols-2 gap-4 text-sm">
          <div>
            <dt class="text-[var(--muted-foreground)]">Расстояние</dt>
            <dd class="font-semibold">{formatDistance(data.distanceKm)}</dd>
          </div>
          <div>
            <dt class="text-[var(--muted-foreground)]">Длительность</dt>
            <dd class="font-semibold">{formatDuration(data.durationMin)}</dd>
          </div>
          <div>
            <dt class="text-[var(--muted-foreground)]">Сложность</dt>
            <dd class="font-semibold">{DIFFICULTY_LABELS[data.difficulty]}</dd>
          </div>
          <div>
            <dt class="text-[var(--muted-foreground)]">Сезон</dt>
            <dd class="font-semibold">{SEASON_LABELS[data.season]}</dd>
          </div>
        </dl>

        <div class="flex gap-2">
          {gpxVariants ? (
            <GpxDownloadButton variants={gpxVariants} client:load />
          ) : (
            <GpxDownloadButton
              gpx={data.gpx}
              slug={route.id}
              name={data.title}
              client:load
            />
          )}
        </div>
      </div>
    </header>

    <div id="route-content" class="route-prose prose prose-neutral mt-10 max-w-none">
      <Content />
    </div>

    {data.author && (data.author.bio || data.author.vkUrl) && (
      <div class="mx-auto mt-10 max-w-3xl rounded-xl border border-[var(--border)] bg-[var(--card)] p-5">
        <div class="text-xs uppercase tracking-wide text-[var(--muted-foreground)]">
          Автор маршрута
        </div>
        <div class="mt-2 flex items-center gap-3">
          {data.author.avatar && (
            <img
              src={data.author.avatar}
              alt={data.author.name}
              class="size-10 rounded-full object-cover"
              loading="lazy"
            />
          )}
          <div>
            <div class="font-semibold">{data.author.name}</div>
            {data.author.isOrganizer && (
              <div class="text-xs text-[var(--primary)]">Организатор Томской Прогулки</div>
            )}
          </div>
        </div>
        {data.author.bio && (
          <p class="mt-3 text-sm text-[var(--muted-foreground)]">{data.author.bio}</p>
        )}
        {data.author.vkUrl && (
          <a
            href={data.author.vkUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center gap-1.5 text-sm text-[var(--primary)] hover:underline"
          >
            Профиль ВКонтакте →
          </a>
        )}
      </div>
    )}

    <section id="route-map" class="mx-auto mt-10 max-w-5xl scroll-mt-24">
      <h2 class="mb-4 text-2xl font-semibold">Маршрут на карте</h2>
      <div class="h-[480px] overflow-hidden rounded-xl border border-[var(--border)]">
        <RouteMap tracks={mapTracks} client:only="react" />
      </div>
    </section>

    {data.howToGetCustomText && (
      <section class="mx-auto mt-10 max-w-3xl">
        <h2 class="mb-3 text-2xl font-semibold">Как добраться</h2>
        <div class="prose prose-neutral max-w-none whitespace-pre-line">
          {data.howToGetCustomText}
        </div>
      </section>
    )}

    {data.whatToTakeCustomText && (
      <section class="mx-auto mt-10 max-w-3xl">
        <h2 class="mb-3 text-2xl font-semibold">Что взять</h2>
        <div class="prose prose-neutral max-w-none whitespace-pre-line">
          {data.whatToTakeCustomText}
        </div>
      </section>
    )}

    <LightboxRoot client:idle />
  </article>
</BaseLayout>
