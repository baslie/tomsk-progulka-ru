---
import "@fontsource-variable/inter";
import "@/styles/globals.css";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import SEO from "@/components/seo/SEO.astro";
import YandexMetrika from "@/components/analytics/YandexMetrika.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  canonical?: string;
  heroOverlay?: boolean;
}

const {
  title,
  description,
  image,
  type,
  canonical,
  heroOverlay = false,
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="p:domain_verify" content="b791ec9276857eddc8fa55257606340b" />
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      canonical={canonical}
    />
    <YandexMetrika />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header transparentOnTop={heroOverlay} />
    <main class:list={["flex-1", !heroOverlay && "pt-16"]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
