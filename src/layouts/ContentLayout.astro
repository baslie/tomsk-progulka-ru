---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} type="article">
  <article class="container max-w-3xl py-10">
    <slot />
  </article>
</BaseLayout>
